# Normaliza a quebra de linha. Sem isto o Windows grava CRLF e o Mac grava LF,
# e o git passa a marcar arquivos inteiros como modificados sem que nada tenha
# mudado de fato.
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

*.png binary
*.pdf binary
*.gitbundle binary
